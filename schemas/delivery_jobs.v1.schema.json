        },
        "blocked_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "missing_boss_identifier",
              "invalid_boss_identifier",
              "invalid_job_url",
              "conflicting_identifiers",
