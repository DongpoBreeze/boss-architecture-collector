{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boss-architecture-collector.local/schemas/delivery_jobs.v1.schema.json",
  "title": "Independent BOSS delivery jobs v1",
  "description": "Only the current confirmed final keep set from import, shortlist, fetch-jd and llm. Existing AI review fields are copied as records with validation=not_checked; their contents, status, format, identity and signatures do not decide export eligibility. Null, blank and empty optional values may be omitted; empty jobs and blocked_jobs lists may be absent. job_key is stable for the same task record across exports; job_id is the task-local source identity and is never a BOSS target id. Duplicate BOSS targets are blocked in full; no raw source paths, provider data or report fields are allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "generated_at",
    "source_task",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "export_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "name",
        "track",
        "created_at",
        "review_revision",
        "review_stages"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "track": {
          "type": "string",
          "enum": [
            "all",
            "current",
            "target"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_stages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "import",
            "shortlist",
            "fetch-jd",
            "llm"
          ],
          "properties": {
            "import": {
              "type": "integer",
              "minimum": 0
            },
            "shortlist": {
              "type": "integer",
              "minimum": 0
            },
            "fetch-jd": {
              "type": "integer",
              "minimum": 0
            },
            "llm": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_count",
        "ready_count",
        "blocked_count"
      ],
      "properties": {
        "selected_count": {
          "type": "integer",
          "minimum": 0
        },
        "ready_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/job"
      }
    },
    "blocked_jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocked_job"
      }
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_key",
        "job_id",
        "ai_review",
        "selection"
      ],
      "properties": {
        "job_key": {
          "type": "string",
          "pattern": "^job_[a-f0-9]{64}$"
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "boss_job_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "job_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://www\\.zhipin\\.com/job_detail/[A-Za-z0-9][A-Za-z0-9_-]{0,127}\\.html$"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "company": {
          "description": "Company name from explicit company fields or the known legacy API brandName mapping; never an unverified recruiter name.",
          "type": [
            "string",
            "null"
          ]
        },
        "encrypt_brand_id": {
          "description": "Original encrypted company ID; may contain trailing ~ padding and is never a job target ID.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_~-]{0,127}$"
        },
        "company_link": {
          "description": "Original BOSS company detail URL without query strings, fragments or credentials.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://(?:[a-z0-9-]+\\.)*zhipin\\.com(?::(?:80|443))?/gongsi/[A-Za-z0-9][A-Za-z0-9_~-]{0,127}\\.html$"
        },
        "company_industry": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_scale": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "district": {
          "type": [
            "string",
            "null"
          ]
        },
        "business_district": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "salary": {
          "type": [
            "string",
            "null"
          ]
        },
        "experience": {
          "description": "Original job experience requirement from an explicit experience field or an unambiguous list label; never a search filter or an inference from the JD.",
          "type": [
            "string",
            "null"
          ]
        },
        "education": {
          "type": [
            "string",
            "null"
          ]
        },
        "skills": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "job_labels": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "jd": {
          "type": [
            "string",
            "null"
          ]
        },
        "ai_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "validation"
          ],
          "properties": {
            "format": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "description": "The recorded textual status; missing denotes no review and invalid denotes an unreadable status. Export does not certify success.",
              "type": "string",
              "minLength": 1
            },
            "judgment": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "validation": {
              "description": "New exports use not_checked. Earlier validation values remain readable for existing v1 exports.",
              "type": "string",
              "enum": [
                "not_checked",
                "input_match",
                "missing_review",
                "review_failed",
                "invalid_status",
                "job_identity_changed",
                "jd_incomplete",
                "input_changed",
                "invalid_review_format",
                "missing_signature",
                "prompt_unavailable",
                "not_applicable"
              ]
            }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage",
            "confirmed",
            "keep",
            "source"
          ],
          "properties": {
            "stage": {
              "const": "llm",
              "type": "string"
            },
            "confirmed": {
              "const": true,
              "type": "boolean"
            },
            "keep": {
              "const": true,
              "type": "boolean"
            },
            "source": {
              "type": "string",
              "enum": [
                "manual",
                "ai"
              ]
            },
            "manual_keep": {
              "type": [
                "boolean",
                "null"
              ],
              "enum": [
                true,
                null
              ]
            }
          }
        },
        "navigation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "original_job_url": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^https?://(?:[A-Za-z0-9-]+\\.)*zhipin\\.com(?::80|:443)?/job_detail/[A-Za-z0-9][A-Za-z0-9_-]{0,127}\\.html(?:\\?[A-Za-z0-9_.=&%~:/+@-]+)?$"
            },
            "lid": {
              "type": ["string", "null"],
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._~:/+=@-]{1,512}$"
            },
            "ka": {
              "type": ["string", "null"],
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._~:/+=@-]{1,512}$"
            },
            "from": {
              "type": ["string", "null"],
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._~:/+=@-]{1,512}$"
            },
            "security_id": {
              "type": ["string", "null"],
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._~:/+=@-]{1,512}$"
            },
            "encrypt_boss_id": {
              "description": "Opaque recruiter navigation hint. Never a job target identifier.",
              "type": ["string", "null"],
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._~:/+=@-]{1,512}$"
            }
          }
        }
      },
      "anyOf": [
        {
          "required": ["boss_job_id"],
          "properties": {
            "boss_job_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": ["job_url"],
          "properties": {
            "job_url": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "blocked_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_key",
        "job_id",
        "ai_review",
        "selection",
        "blocked_reasons"
      ],
      "properties": {
        "job_key": {
          "type": "string",
          "pattern": "^job_[a-f0-9]{64}$"
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "boss_job_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "job_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://www\\.zhipin\\.com/job_detail/[A-Za-z0-9][A-Za-z0-9_-]{0,127}\\.html$"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "company": {
          "description": "Company name from explicit company fields or the known legacy API brandName mapping; never an unverified recruiter name.",
          "type": [
            "string",
            "null"
          ]
        },
        "encrypt_brand_id": {
          "description": "Original encrypted company ID; may contain trailing ~ padding and is never a job target ID.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_~-]{0,127}$"
        },
        "company_link": {
          "description": "Original BOSS company detail URL without query strings, fragments or credentials.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://(?:[a-z0-9-]+\\.)*zhipin\\.com(?::(?:80|443))?/gongsi/[A-Za-z0-9][A-Za-z0-9_~-]{0,127}\\.html$"
        },
        "company_industry": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_scale": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "district": {
          "type": [
            "string",
            "null"
          ]
        },
        "business_district": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "salary": {
          "type": [
            "string",
            "null"
          ]
        },
        "experience": {
          "description": "Original job experience requirement from an explicit experience field or an unambiguous list label; never a search filter or an inference from the JD.",
          "type": [
            "string",
            "null"
          ]
        },
        "education": {
          "type": [
            "string",
            "null"
          ]
        },
        "skills": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "job_labels": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "jd": {
          "type": [
            "string",
            "null"
          ]
        },
        "ai_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "validation"
          ],
          "properties": {
            "format": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "description": "The recorded textual status; missing denotes no review and invalid denotes an unreadable status. Export does not certify success.",
              "type": "string",
              "minLength": 1
            },
            "judgment": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "validation": {
              "description": "New exports use not_checked. Earlier validation values remain readable for existing v1 exports.",
              "type": "string",
              "enum": [
                "not_checked",
                "input_match",
                "missing_review",
                "review_failed",
                "invalid_status",
                "job_identity_changed",
                "jd_incomplete",
                "input_changed",
                "invalid_review_format",
                "missing_signature",
                "prompt_unavailable",
                "not_applicable"
              ]
            }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage",
            "confirmed",
            "keep",
            "source"
          ],
          "properties": {
            "stage": {
              "const": "llm",
              "type": "string"
            },
            "confirmed": {
              "const": true,
              "type": "boolean"
            },
            "keep": {
              "const": true,
              "type": "boolean"
            },
            "source": {
              "type": "string",
              "enum": [
                "manual",
                "ai"
              ]
            },
            "manual_keep": {
              "type": [
                "boolean",
                "null"
              ],
              "enum": [
                true,
                null
              ]
            }
          }
        },
        "navigation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "original_job_url": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^https?://(?:[A-Za-z0-9-]+\\.)*zhipin\\.com(?::80|:443)?/job_detail/[A-Za-z0-9][A-Za-z0-9_-]{0,127}\\.html(?:\\?[A-Za-z0-9_.=&%~:/+@-]+)?$"
            },
            "lid": {
              "type": ["string", "null"],
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._~:/+=@-]{1,512}$"
            },
            "ka": {
              "type": ["string", "null"],
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._~:/+=@-]{1,512}$"
            },
            "from": {
              "type": ["string", "null"],
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._~:/+=@-]{1,512}$"
            },
